rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Backend-only model:
    // Firebase Admin SDK (Cloud Functions) bypasses Firestore security rules.
    // Deny all direct client SDK reads/writes to avoid privilege drift and spoof paths.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}